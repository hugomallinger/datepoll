{
  "manifest_version": 3,
  "name": "Datepoll",
  "version": "0.3.1",
  "description": "Create date polls on WhatsApp Web in one click.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["selectors.js", "fill-poll.js", "dates.js", "panel.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
